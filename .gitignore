# ---------- Secrets (never commit these) ----------
# API keys for Anthropic, OpenAI, etc. belong here, not in your code
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/

# ---------- Python bytecode and caches ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---------- Packaging and build output ----------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Testing and coverage ----------
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- Jupyter notebooks ----------
.ipynb_checkpoints/

# ---------- Logs and local data ----------
*.log
logs/
*.sqlite3
*.db

# ---------- VS Code ----------
# Ignore personal editor files, but keep shared project settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------- Other editors ----------
.idea/
*.swp
*.swo
*~

# ---------- Miscellaneous ----------
learn.py
learn.ipynb
*.zip
